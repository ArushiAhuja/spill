DATABASE_URL=postgres://...
# Managed Postgres options (any one is fine — Spill is stock Postgres via pg):
# - Supabase: Project Settings → Database → URI (session mode :5432 for migrate)
# - Azure Database for PostgreSQL Flexible Server:
#   postgresql://USER@SERVER:PASSWORD@SERVER.postgres.database.azure.com:5432/postgres?sslmode=require
#   Or: postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/DATABASE?sslmode=require
#   After Azure deploy: Networking → allow your IP + 0.0.0.0/0 only if you accept public access;
#   set require_secure_transport = on (default). Create a database (e.g. spill) if not using postgres.
JWT_SECRET=your_secret_here
CRON_SECRET=random_secret_for_cron_protection
OPENAI_API_KEY=sk-...
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
ESCALATE_THRESHOLD=50
REFRESH_INTERVAL_MINUTES=5
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
